# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO

# Database (PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_pass
POSTGRES_DB=industrial_intelligence
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg2://postgres:postgres_secure_pass@localhost:5432/industrial_intelligence

# Redis / Queue
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# API Settings
API_V1_PREFIX=/api/v1
PROJECT_NAME="INDUSTRIAL INTELLIGENCE"
CORS_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000"

# Scraping Settings
DEFAULT_CRAWL_DELAY_SECONDS=2.0
MAX_RETRIES=3
USER_AGENT="IndustrialIntelligenceBot/1.0 (+https://example.com/bot; research@industrialintel.local)"
RESPECT_ROBOTS_TXT=true

# LLM Classification / Extraction (Optional)
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
